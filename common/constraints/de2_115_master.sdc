## Synopsys Design Constraints (SDC) for Terasic DE2-115 (Cyclone IV EP4CE115F29C7)

# 50 MHz On-board Clocks
create_clock -name CLOCK_50  -period 20.000 [get_ports {CLOCK_50}]
create_clock -name CLOCK2_50 -period 20.000 [get_ports {CLOCK2_50}]
create_clock -name CLOCK3_50 -period 20.000 [get_ports {CLOCK3_50}]

# Audio Codec Bit Clock (if generated by external codec master, ~3.072 MHz for 48kHz 32-bit slot)
create_clock -name AUD_BCLK -period 325.52 [get_ports {AUD_BCLK}]

# Automatically derive clock uncertainty
derive_clock_uncertainty

# Cut asynchronous reset paths
set_false_path -from [get_ports {KEY[*]}]
set_false_path -from [get_ports {SW[*]}]

# Cut slow human-interface outputs (LEDs, 7-Segment, LCD control)
set_false_path -to [get_ports {LEDR[*]}]
set_false_path -to [get_ports {LEDG[*]}]
set_false_path -to [get_ports {HEX0[*]}]
set_false_path -to [get_ports {HEX1[*]}]
set_false_path -to [get_ports {HEX2[*]}]
set_false_path -to [get_ports {HEX3[*]}]
set_false_path -to [get_ports {HEX4[*]}]
set_false_path -to [get_ports {HEX5[*]}]
set_false_path -to [get_ports {HEX6[*]}]
set_false_path -to [get_ports {HEX7[*]}]
set_false_path -to [get_ports {LCD_*}]
